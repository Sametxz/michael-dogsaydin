[
 {
  "out": "/home/claude/r3/bati/ses/a00.wav",
  "text": "السنة سبعمئة وثلاث وتسعون. أنت مزارع على ضفة مضيق كاتيغات. اسمك راغنار.",
  "tag": "[storytelling, dry wit]"
 },
 {
  "out": "/home/claude/r3/bati/ses/a01.wav",
  "text": "حاكم المنطقة هو الإيرل هارالدسون. والإيرل سيّد الإقليم.",
  "tag": "[storytelling, dry wit]"
 },
 {
  "out": "/home/claude/r3/bati/ses/a02.wav",
  "text": "كل صيف يرسل رجاله شرقًا للنهب.",
  "tag": "[storytelling, dry wit]"
 },
 {
  "out": "/home/claude/r3/bati/ses/a03.wav",
  "text": "ماذا في الشرق؟ قرى فقيرة. وقرى أفقر منها.",
  "tag": "[dry, amused]"
 },
 {
  "out": "/home/claude/r3/bati/ses/a04.wav",
  "text": "أنت تؤمن بوجود أراضٍ غنية في الغرب. فيضحك الإيرل ويحرّم الغرب.",
  "tag": "[storytelling, dry wit]"
 },
 {
  "out": "/home/claude/r3/bati/ses/a05.wav",
  "text": "لكن الغرب بحر مفتوح. لا خريطة ولا بوصلة.",
  "tag": "[storytelling, dry wit]"
 },
 {
  "out": "/home/claude/r3/bati/ses/a06.wav",
  "text": "من مسافر تحصل على أداتين. لوح الشمس وحجر الشمس.",
  "tag": "[storytelling, dry wit]"
 },
 {
  "out": "/home/claude/r3/bati/ses/a07.wav",
  "text": "الحجر يُري الشمس حتى خلف السحب. لن تضلّ الطريق بعد اليوم.",
  "tag": "[storytelling, dry wit]"
 },
 {
  "out": "/home/claude/r3/bati/ses/a08.wav",
  "text": "وتحتاج إلى سفينة. يبنيها أقرب أصدقائك، فلوكي.",
  "tag": "[storytelling, dry wit]"
 },
 {
  "out": "/home/claude/r3/bati/ses/a09.wav",
  "text": "مجنون قليلًا، لكنه عبقري. سفينته تصمد في المحيط وتدخل الأنهار.",
  "tag": "[amused]"
 },
 {
  "out": "/home/claude/r3/bati/ses/a10.wav",
  "text": "سرًّا عن الإيرل، تبحر مع حفنة من الرجال.",
  "tag": "[storytelling, dry wit]"
 },
 {
  "out": "/home/claude/r3/bati/ses/a11.wav",
  "text": "في العاصفة يقهقه فلوكي. وأنت تصلّي.",
  "tag": "[storytelling, dry wit]"
 },
 {
  "out": "/home/claude/r3/bati/ses/a12.wav",
  "text": "بعد أيام تلوح اليابسة. إنجلترا. أمامك دير: ليندسفارن.",
  "tag": "[storytelling, dry wit]"
 },
 {
  "out": "/home/claude/r3/bati/ses/a13.wav",
  "text": "عند الرهبان ذهب كثير ولا سلاح. هذه الغارة ستفتتح عصر الفايكنغ.",
  "tag": "[storytelling, dry wit]"
 },
 {
  "out": "/home/claude/r3/bati/ses/a14.wav",
  "text": "أحد الرهبان يتكلم لغتك. اسمه أثيلستان.",
  "tag": "[storytelling, dry wit]"
 },
 {
  "out": "/home/claude/r3/bati/ses/a15.wav",
  "text": "لا تقتله. تأخذه عبدًا معك. هذا الرجل سيهزّ إيمانك يومًا ما.",
  "tag": "[storytelling, dry wit]"
 },
 {
  "out": "/home/claude/r3/bati/ses/a16.wav",
  "text": "كفى. تتحدّى الإيرل إلى نزال. تتشكّل حلقة من الدروع.",
  "tag": "[storytelling, dry wit]"
 },
 {
  "out": "/home/claude/r3/bati/ses/a17.wav",
  "text": "واحد فقط سيخرج منها.",
  "tag": "[storytelling, dry wit]"
 },
 {
  "out": "/home/claude/r3/bati/ses/a18.wav",
  "text": "يسقط الإيرل.",
  "tag": "[firm]"
 },
 {
  "out": "/home/claude/r3/bati/ses/a19.wav",
  "text": "إيرل كاتيغات الجديد هو أنت الآن.",
  "tag": "[storytelling, dry wit]"
 },
 {
  "out": "/home/claude/r3/bati/ses/a20.wav",
  "text": "أول عمل لك: تقاسم الغنائم مع الناس.",
  "tag": "[storytelling, dry wit]"
 },
 {
  "out": "/home/claude/r3/bedel/ses/b00.wav",
  "text": "يحلّ الطاعون بكاتيغات.",
  "tag": "[somber]"
 },
 {
  "out": "/home/claude/r3/bedel/ses/b01.wav",
  "text": "يأخذ الأطفال أولًا.",
  "tag": "[somber]"
 },
 {
  "out": "/home/claude/r3/bedel/ses/b02.wav",
  "text": "تمسك يد ابنتك غيدا.",
  "tag": "[somber]"
 },
 {
  "out": "/home/claude/r3/bedel/ses/b03.wav",
  "text": "وتنطفئ الشمعة.",
  "tag": "[somber]"
 },
 {
  "out": "/home/claude/r3/bedel/ses/b04.wav",
  "text": "أمّها تُشعل المحرقة.",
  "tag": "[somber]"
 },
 {
  "out": "/home/claude/r3/bedel/ses/b05.wav",
  "text": "وأنت لا تملك إلا النظر.",
  "tag": "[somber]"
 },
 {
  "out": "/home/claude/r3/bedel/ses/b06.wav",
  "text": "أخوك رولو في الصف المقابل، بجانب الإيرل بورغ.",
  "tag": "[somber]"
 },
 {
  "out": "/home/claude/r3/bedel/ses/b07.wav",
  "text": "لا يستطيع رفع سلاحه عليك.",
  "tag": "[somber]"
 },
 {
  "out": "/home/claude/r3/bedel/ses/b08.wav",
  "text": "وأنت لا تستطيع قتله.",
  "tag": "[somber]"
 },
 {
  "out": "/home/claude/r3/bedel/ses/b09.wav",
  "text": "الملك هوريك يثق بك. وأنت به.",
  "tag": "[somber]"
 },
 {
  "out": "/home/claude/r3/bedel/ses/b10.wav",
  "text": "كلاكما تكذب.",
  "tag": "[somber]"
 },
 {
  "out": "/home/claude/r3/bedel/ses/b11.wav",
  "text": "لكنك أبرع في الكذب.",
  "tag": "[somber]"
 },
 {
  "out": "/home/claude/r3/bedel/ses/b12.wav",
  "text": "أنت الآن ملك.",
  "tag": "[proud]"
 },
 {
  "out": "/home/claude/r3/ivar2/ses/n00.wav",
  "text": "تهبك أسلاوغ ابنًا آخر.",
  "tag": "[tender, sad]"
 },
 {
  "out": "/home/claude/r3/ivar2/ses/n01.wav",
  "text": "تسمّيانه إيفار.",
  "tag": "[tender, sad]"
 },
 {
  "out": "/home/claude/r3/ivar2/ses/n02.wav",
  "text": "لكن ساقي الرضيع معوجّتان، وعظامه هشّة كالزجاج.",
  "tag": "[tender, sad]"
 },
 {
  "out": "/home/claude/r3/ivar2/ses/n03.wav",
  "text": "أسلاوغ تضمّه بقوة. وأنت تشيح بنظرك.",
  "tag": "[tender, sad]"
 },
 {
  "out": "/home/claude/r3/ivar2/ses/n04.wav",
  "text": "في هذا العالم لا يعيش الضعيف. وأنت تعرف ذلك أكثر من الجميع.",
  "tag": "[tender, sad]"
 },
 {
  "out": "/home/claude/r3/ivar2/ses/n05.wav",
  "text": "في تلك الليلة، والكل نائم، تأخذ ابنك من حضن أمه.",
  "tag": "[tender, sad]"
 },
 {
  "out": "/home/claude/r3/ivar2/ses/n06.wav",
  "text": "ضفة النهر باردة كالجليد.",
  "tag": "[tender, sad]"
 },
 {
  "out": "/home/claude/r3/ivar2/ses/n07.wav",
  "text": "ترفع النصل.",
  "tag": "[tender, sad]"
 },
 {
  "out": "/home/claude/r3/ivar2/ses/n08.wav",
  "text": "حركة واحدة. هذا كل شيء.",
  "tag": "[tender, sad]"
 },
 {
  "out": "/home/claude/r3/ivar2/ses/n09.wav",
  "text": "ثم تعثر يدٌ صغيرة على إصبعك.",
  "tag": "[tender, sad]"
 },
 {
  "out": "/home/claude/r3/ivar2/ses/n10.wav",
  "text": "وتقبض عليه بقوة.",
  "tag": "[tender, sad]"
 },
 {
  "out": "/home/claude/r3/ivar2/ses/n11.wav",
  "text": "لا تستطيع.",
  "tag": "[tender, sad]"
 },
 {
  "out": "/home/claude/r3/ivar2/ses/n12.wav",
  "text": "تتركه هناك، في الضباب.",
  "tag": "[tender, sad]"
 },
 {
  "out": "/home/claude/r3/ivar2/ses/n13.wav",
  "text": "لكن الأم تجد طفلها دائمًا.",
  "tag": "[tender, sad]"
 },
 {
  "out": "/home/claude/r3/ivar2/ses/n14.wav",
  "text": "وسيصبح ذلك الطفل يومًا إيفار عديم العظام.",
  "tag": "[tender, sad]"
 },
 {
  "out": "/home/claude/r3/ivar2/ses/n15.wav",
  "text": "الرضيع الذي عجز أبوه عن أذيّته سيجعل العالم كله يرتجف.",
  "tag": "[tender, sad]"
 },
 {
  "out": "/home/claude/r3/ivar2/ses/n16.wav",
  "text": "تحمله إلى الغابة.",
  "tag": "[tender, sad]"
 },
 {
  "out": "/home/claude/r3/ivar2/ses/n17.wav",
  "text": "حياة بحجم إصبعك.",
  "tag": "[tender, sad]"
 },
 {
  "out": "/home/claude/r3/ivar2/ses/n18.wav",
  "text": "لا تستطيع.",
  "tag": "[soft, broken]"
 },
 {
  "out": "/home/claude/r3/kayip/ses/v00.wav",
  "text": "بعد سنين تعود إلى كاتيغات دون إنذار.",
  "tag": "[weary, sad]"
 },
 {
  "out": "/home/claude/r3/kayip/ses/v01.wav",
  "text": "أبناؤك أصبحوا رجالًا.",
  "tag": "[weary, sad]"
 },
 {
  "out": "/home/claude/r3/kayip/ses/v02.wav",
  "text": "تسأل: «من يريد أن يكون ملكًا؟». لا أحد يريد.",
  "tag": "[quiet, heavy]"
 },
 {
  "out": "/home/claude/r3/kayip/ses/v03.wav",
  "text": "إيفار وحده يستقبلك بذراعين مفتوحتين.",
  "tag": "[weary, sad]"
 },
 {
  "out": "/home/claude/r3/kayip/ses/v04.wav",
  "text": "في يوم تقف تحت شجرة عملاقة. لم تعد تريد المتابعة.",
  "tag": "[weary, sad]"
 },
 {
  "out": "/home/claude/r3/kayip/ses/v05.wav",
  "text": "لكن الغربان تقرض الحبل. الآلهة لا تتركك.",
  "tag": "[weary, sad]"
 },
 {
  "out": "/home/claude/r3/kayip/ses/v06.wav",
  "text": "تبحث عن رجال لرحلة أخيرة. لا يأتي إلا إيفار.",
  "tag": "[weary, sad]"
 },
 {
  "out": "/home/claude/r3/kayip/ses/v07.wav",
  "text": "تبتلع العاصفة أسطولك. لا ينجو سواكما.",
  "tag": "[weary, sad]"
 },
 {
  "out": "/home/claude/r3/kesis/ses/k00.wav",
  "text": "أثيلستان الآن أقرب أصدقائك.",
  "tag": "[melancholic]"
 },
 {
  "out": "/home/claude/r3/kesis/ses/k01.wav",
  "text": "ليالي طويلة تتحدثان عن الآلهة.",
  "tag": "[melancholic]"
 },
 {
  "out": "/home/claude/r3/kesis/ses/k02.wav",
  "text": "أنت تتأمل في إلهه، وهو في آلهتك.",
  "tag": "[melancholic]"
 },
 {
  "out": "/home/claude/r3/kesis/ses/k03.wav",
  "text": "في صباح يرى نورًا في الماء.",
  "tag": "[melancholic]"
 },
 {
  "out": "/home/claude/r3/kesis/ses/k04.wav",
  "text": "ويعود إلى إيمانه القديم.",
  "tag": "[melancholic]"
 },
 {
  "out": "/home/claude/r3/kesis/ses/k05.wav",
  "text": "يرى فلوكي في ذلك خيانة.",
  "tag": "[melancholic]"
 },
 {
  "out": "/home/claude/r3/kesis/ses/k06.wav",
  "text": "أثيلستان لا يهرب. يُتمّ صلاته.",
  "tag": "[melancholic]"
 },
 {
  "out": "/home/claude/r3/kesis/ses/k07.wav",
  "text": "ويقتله فلوكي.",
  "tag": "[melancholic]"
 },
 {
  "out": "/home/claude/r3/kesis/ses/k08.wav",
  "text": "حين تعود، يكون صديقك ممددًا على الأرض.",
  "tag": "[melancholic]"
 },
 {
  "out": "/home/claude/r3/kesis/ses/k09.wav",
  "text": "استراحة قصيرة.",
  "tag": "[melancholic]"
 },
 {
  "out": "/home/claude/r3/kesis/ses/k10.wav",
  "text": "أي شخصية تولد بعد ذلك؟ اكتب في التعليقات.",
  "tag": "[melancholic]"
 },
 {
  "out": "/home/claude/r3/paris/ses/p0.wav",
  "text": "لا تقدر على تجاوز الأسوار.",
  "tag": "[tense, storytelling]"
 },
 {
  "out": "/home/claude/r3/paris/ses/p1.wav",
  "text": "فتقرر أن تموت.",
  "tag": "[tense, storytelling]"
 },
 {
  "out": "/home/claude/r3/paris/ses/p2.wav",
  "text": "الجميع يأتي لوداع نعشك.",
  "tag": "[tense, storytelling]"
 },
 {
  "out": "/home/claude/r3/paris/ses/p3.wav",
  "text": "تسمع كل شيء.",
  "tag": "[tense, storytelling]"
 },
 {
  "out": "/home/claude/r3/paris/ses/p4.wav",
  "text": "ستة رجال عزّل يحملونك إلى المدينة.",
  "tag": "[tense, storytelling]"
 },
 {
  "out": "/home/claude/r3/paris/ses/p5.wav",
  "text": "السلاح في النعش.",
  "tag": "[tense, storytelling]"
 },
 {
  "out": "/home/claude/r3/paris/ses/p6.wav",
  "text": "في الكنيسة تنهض.",
  "tag": "[tense, storytelling]"
 },
 {
  "out": "/home/claude/r3/paris/ses/p7.wav",
  "text": "الكهنة لم يدرجوا هذا في برنامجهم.",
  "tag": "[tense, storytelling]"
 },
 {
  "out": "/home/claude/r3/paris/ses/p8.wav",
  "text": "تُفتح الأبواب.",
  "tag": "[tense, storytelling]"
 },
 {
  "out": "/home/claude/r3/paris/ses/p9.wav",
  "text": "وتنهار في أحضان ابنك.",
  "tag": "[tense, storytelling]"
 },
 {
  "out": "/home/claude/r3/paris/ses/r00.wav",
  "text": "حدّثك أثيلستان عن مدينة. باريس.",
  "tag": "[tense, storytelling]"
 },
 {
  "out": "/home/claude/r3/paris/ses/r01.wav",
  "text": "جزيرة وسط النهر. تحيط بها أسوار حجرية منيعة.",
  "tag": "[tense, storytelling]"
 },
 {
  "out": "/home/claude/r3/paris/ses/r02.wav",
  "text": "تبتلع الأسوار هجومكم الأول.",
  "tag": "[tense, storytelling]"
 },
 {
  "out": "/home/claude/r3/paris/ses/r03.wav",
  "text": "تسقط من السور. جريحًا، محمومًا.",
  "tag": "[tense, storytelling]"
 },
 {
  "out": "/home/claude/r3/paris/ses/r04.wav",
  "text": "إن لم يُفتح الباب، فاجعلهم يحملونك إلى الداخل.",
  "tag": "[tense, storytelling]"
 },
 {
  "out": "/home/claude/r3/paris/ses/r05.wav",
  "text": "تتعمّد. ثم تموت. أو يبدو أنك مت.",
  "tag": "[sly]"
 },
 {
  "out": "/home/claude/r3/paris/ses/r06.wav",
  "text": "رجالك يُدخلون نعشك المدينة لجنازة مسيحية.",
  "tag": "[tense, storytelling]"
 },
 {
  "out": "/home/claude/r3/paris/ses/r07.wav",
  "text": "في الكاتدرائية ينزلق الغطاء. وتنهض.",
  "tag": "[tense, storytelling]"
 },
 {
  "out": "/home/claude/r3/paris/ses/r08.wav",
  "text": "تُفتح الأبواب. تسقط باريس.",
  "tag": "[triumphant]"
 },
 {
  "out": "/home/claude/r3/paris/ses/r09.wav",
  "text": "في طريق العودة تقول لفلوكي كلمة واحدة فقط. أعرف.",
  "tag": "[cold, whispering]"
 },
 {
  "out": "/home/claude/r3/paris/ses/r10.wav",
  "text": "لكن النصر يلتهمك أنت أيضًا. دواء من الشرق.",
  "tag": "[tense, storytelling]"
 },
 {
  "out": "/home/claude/r3/paris/ses/r11.wav",
  "text": "يبقى رولو في باريس. ويتزوج أميرة فرنجية.",
  "tag": "[tense, storytelling]"
 },
 {
  "out": "/home/claude/r3/paris/ses/r12.wav",
  "text": "بعد سنين تعود إلى باريس. هذه المرة أخوك على الأسوار.",
  "tag": "[tense, storytelling]"
 },
 {
  "out": "/home/claude/r3/paris/ses/r13.wav",
  "text": "ويهزمك.",
  "tag": "[tense, storytelling]"
 },
 {
  "out": "/home/claude/r3/prolog/ses/p00.wav",
  "text": "لو وُلدت راغنار لوثبروك، لكنت أول فايكنغ يبحر غربًا.",
  "tag": "[epic, measured]"
 },
 {
  "out": "/home/claude/r3/prolog/ses/p01.wav",
  "text": "ثم ملكًا.",
  "tag": "[epic, measured]"
 },
 {
  "out": "/home/claude/r3/prolog/ses/p02.wav",
  "text": "ثم تأخذ باريس، ناهضًا من نعشك.",
  "tag": "[epic, measured]"
 },
 {
  "out": "/home/claude/r3/prolog/ses/p03.wav",
  "text": "وكل هذا ينبع من سؤال واحد. ماذا في الغرب؟",
  "tag": "[curious, intrigued]"
 },
 {
  "out": "/home/claude/r3/prolog/ses/p04.wav",
  "text": "في الليالي قرب الموقد تحكي لأولادك الحكايات.",
  "tag": "[epic, measured]"
 },
 {
  "out": "/home/claude/r3/prolog/ses/p05.wav",
  "text": "تقول إن نسبك يعود إلى أودين، إله الحرب والحكمة.",
  "tag": "[epic, measured]"
 },
 {
  "out": "/home/claude/r3/prolog/ses/p06.wav",
  "text": "ربما صحيح وربما لا. لكنك تؤمن.",
  "tag": "[epic, measured]"
 },
 {
  "out": "/home/claude/r3/prolog/ses/p07.wav",
  "text": "ابنك بيورن في الثانية عشرة. اليوم تأخذه إلى المجلس.",
  "tag": "[epic, measured]"
 },
 {
  "out": "/home/claude/r3/prolog/ses/p08.wav",
  "text": "ينال من يد الإيرل أول سوار له.",
  "tag": "[epic, measured]"
 },
 {
  "out": "/home/claude/r3/prolog/ses/p09.wav",
  "text": "صار فايكنغيًا هو أيضًا. وتعده أن تُريه الغرب.",
  "tag": "[epic, measured]"
 },
 {
  "out": "/home/claude/r3/son/ses/s00.wav",
  "text": "مع إيفار، تقف عند باب صديقك القديم، الملك إكبرت.",
  "tag": "[solemn]"
 },
 {
  "out": "/home/claude/r3/son/ses/s01.wav",
  "text": "ملكان عجوزان. كلاهما شاخ، وكلاهما أنهكه التعب.",
  "tag": "[solemn]"
 },
 {
  "out": "/home/claude/r3/son/ses/s02.wav",
  "text": "تطلب منه معروفًا أخيرًا. أن يسلّمك إلى الملك إيلا.",
  "tag": "[solemn]"
 },
 {
  "out": "/home/claude/r3/son/ses/s03.wav",
  "text": "ترسل إيفار إلى بيته. وتهمس في أذنه بمهمة.",
  "tag": "[solemn]"
 },
 {
  "out": "/home/claude/r3/son/ses/s04.wav",
  "text": "سينتقمون من إكبرت، لا من إيلا.",
  "tag": "[solemn]"
 },
 {
  "out": "/home/claude/r3/son/ses/s05.wav",
  "text": "عند الرحيل تعلّق صليب أثيلستان في عنق ألفريد الصغير. كان لأبيه.",
  "tag": "[solemn]"
 },
 {
  "out": "/home/claude/r3/son/ses/s06.wav",
  "text": "ثم تُحبس في قفص.",
  "tag": "[solemn]"
 },
 {
  "out": "/home/claude/r3/son/ses/s07.wav",
  "text": "في الطريق ترى العرّافة. تقول لها إنك لم تعد تؤمن بالآلهة.",
  "tag": "[solemn]"
 },
 {
  "out": "/home/claude/r3/son/ses/s08.wav",
  "text": "الملك إيلا ينتظر منك ندمًا. لا تعطيه.",
  "tag": "[solemn]"
 },
 {
  "out": "/home/claude/r3/son/ses/s09.wav",
  "text": "يلقون بك في حفرة مليئة بالأفاعي.",
  "tag": "[solemn]"
 },
 {
  "out": "/home/claude/r3/son/ses/s10.wav",
  "text": "كلماتك الأخيرة لأبنائك. سيأتون، تقول.",
  "tag": "[solemn]"
 },
 {
  "out": "/home/claude/r3/son/ses/s11.wav",
  "text": "وفي السماء غرابان.",
  "tag": "[hushed, awed]"
 },
 {
  "out": "/home/claude/r3/son/ses/s12.wav",
  "text": "وُلدت مزارعًا. ومتّ ملكًا.",
  "tag": "[solemn]"
 },
 {
  "out": "/home/claude/r3/son/ses/s13.wav",
  "text": "كنت أول من ذهب غربًا. وأبناؤك سيلحقون بك.",
  "tag": "[solemn]"
 },
 {
  "out": "/home/claude/r3/son/ses/s14.wav",
  "text": "قل لي إذن. هل كتبت قدرك بنفسك، أم الآلهة؟",
  "tag": "[solemn]"
 },
 {
  "out": "/home/claude/r3/tahta/ses/K0_0.wav",
  "text": "تعود بالغنائم. لكن الإيرل يستولي عليها كلها.",
  "tag": "[storytelling]"
 },
 {
  "out": "/home/claude/r3/tahta/ses/K0_1.wav",
  "text": "لأن الناس صاروا يحبونك. وهذا يخيف الإيرل.",
  "tag": "[storytelling]"
 },
 {
  "out": "/home/claude/r3/tahta/ses/K0_2.wav",
  "text": "يأمر بتعذيب أخيك رولو. وبينما تصطاد، يغير رجاله على مزرعتك.",
  "tag": "[storytelling]"
 },
 {
  "out": "/home/claude/r3/tahta/ses/K1_0.wav",
  "text": "الملك هوريك يرسلك للتفاوض على الأراضي مع الإيرل بورغ.",
  "tag": "[storytelling]"
 },
 {
  "out": "/home/claude/r3/tahta/ses/K1_1.wav",
  "text": "حين تعود، يكون المرض في انتظار كاتيغات.",
  "tag": "[storytelling]"
 },
 {
  "out": "/home/claude/r3/tahta/ses/K2_0.wav",
  "text": "ينهار التفاوض.",
  "tag": "[storytelling]"
 },
 {
  "out": "/home/claude/r3/tahta/ses/K2_1.wav",
  "text": "يعد بورغ أخاك بإمارة خاصة به.",
  "tag": "[storytelling]"
 },
 {
  "out": "/home/claude/r3/tahta/ses/K2_2.wav",
  "text": "رولو تعب من العيش في ظلك.",
  "tag": "[storytelling]"
 },
 {
  "out": "/home/claude/r3/tahta/ses/K3_0.wav",
  "text": "المجلس يعفو عن أخيك.",
  "tag": "[storytelling]"
 },
 {
  "out": "/home/claude/r3/tahta/ses/K3_1.wav",
  "text": "في الأيام نفسها يطرق بابك شخص آخر.",
  "tag": "[storytelling]"
 },
 {
  "out": "/home/claude/r3/tahta/ses/K4_0.wav",
  "text": "تمر أربع سنين.",
  "tag": "[storytelling]"
 },
 {
  "out": "/home/claude/r3/tahta/ses/K4_1.wav",
  "text": "تنجب لك أسلاوغ ثلاثة أبناء. أوبي، هفيتسيرك، سيغورد.",
  "tag": "[storytelling]"
 },
 {
  "out": "/home/claude/r3/tahta/ses/K4_2.wav",
  "text": "وأنت في إنجلترا، يحرق بورغ كاتيغات.",
  "tag": "[storytelling]"
 },
 {
  "out": "/home/claude/r3/tahta/ses/K4_3.wav",
  "text": "تستعيدها. عقاب بورغ: النسر الدموي.",
  "tag": "[storytelling]"
 },
 {
  "out": "/home/claude/r3/tahta/ses/K4_4.wav",
  "text": "في ليلة العودة تطلب أسلاوغ منك الانتظار ثلاث ليالٍ.",
  "tag": "[storytelling]"
 },
 {
  "out": "/home/claude/r3/tahta/ses/K4_5.wav",
  "text": "لا تنتظر.",
  "tag": "[cold]"
 },
 {
  "out": "/home/claude/r3/tahta/ses/K5_0.wav",
  "text": "يخشى هوريك أن يبقى في ظلك.",
  "tag": "[storytelling]"
 },
 {
  "out": "/home/claude/r3/tahta/ses/K5_1.wav",
  "text": "يحاول كسب فلوكي إلى صفه.",
  "tag": "[storytelling]"
 },
 {
  "out": "/home/claude/r3/tahta/ses/K5_2.wav",
  "text": "يخبرك فلوكي بكل شيء.",
  "tag": "[storytelling]"
 },
 {
  "out": "/home/claude/r3/tahta/ses/K6_0.wav",
  "text": "تعود إلى إنجلترا ملكًا.",
  "tag": "[storytelling]"
 },
 {
  "out": "/home/claude/r3/tahta/ses/K6_1.wav",
  "text": "الملك إكبرت يمنحكم أرضًا.",
  "tag": "[storytelling]"
 },
 {
  "out": "/home/claude/r3/tahta/ses/K6_2.wav",
  "text": "أما أثيلستان فيبقى ممزقًا بين إلهين.",
  "tag": "[storytelling]"
 },
 {
  "out": "/home/claude/r3/veda2/ses/v00.wav",
  "text": "في رحلة تلتقي أسلاوغ.",
  "tag": "[melancholic]"
 },
 {
  "out": "/home/claude/r3/veda2/ses/v01.wav",
  "text": "بعد أشهر تأتي إلى قاعتك.",
  "tag": "[melancholic]"
 },
 {
  "out": "/home/claude/r3/veda2/ses/v02.wav",
  "text": "في بطنها طفلك.",
  "tag": "[melancholic]"
 },
 {
  "out": "/home/claude/r3/veda2/ses/v03.wav",
  "text": "تقول: يمكن أن تكون لي زوجتان.",
  "tag": "[melancholic]"
 },
 {
  "out": "/home/claude/r3/veda2/ses/v04.wav",
  "text": "تقبل أسلاوغ. ولاغرثا لا تقبل.",
  "tag": "[melancholic]"
 },
 {
  "out": "/home/claude/r3/veda2/ses/v05.wav",
  "text": "تتقلد سيفها وتحمّل صناديقها على العربة.",
  "tag": "[melancholic]"
 },
 {
  "out": "/home/claude/r3/veda2/ses/v06.wav",
  "text": "يختار بيورن البقاء معك.",
  "tag": "[melancholic]"
 },
 {
  "out": "/home/claude/r3/veda2/ses/v07.wav",
  "text": "تقبّله أمه وترحل.",
  "tag": "[melancholic]"
 },
 {
  "out": "/home/claude/r3/veda2/ses/v08.wav",
  "text": "ثم يركض بيورن خلف العربة.",
  "tag": "[melancholic]"
 },
 {
  "out": "/home/claude/r3/veda2/ses/v09.wav",
  "text": "لا توقفه.",
  "tag": "[melancholic]"
 },
 {
  "out": "/home/claude/r3/veda2/ses/v10.wav",
  "text": "تقول له فقط أن يعتني بأمه.",
  "tag": "[melancholic]"
 },
 {
  "out": "/home/claude/r3/veda2/ses/v11.wav",
  "text": "تبني مملكة.",
  "tag": "[melancholic]"
 },
 {
  "out": "/home/claude/r3/veda2/ses/v12.wav",
  "text": "لكنك تفقد عائلة.",
  "tag": "[melancholic]"
 },
 {
  "out": "/home/claude/r3/yas_ses/d0.wav",
  "text": "لا تسلّمه لأحد. تحمله بنفسك.",
  "tag": "[grieving, quiet]"
 },
 {
  "out": "/home/claude/r3/yas_ses/d1.wav",
  "text": "إلى حيث كان يصلي كل صباح. عند أعلى الشلال.",
  "tag": "[grieving, quiet]"
 },
 {
  "out": "/home/claude/r3/yas_ses/d2.wav",
  "text": "أنت من يغرس صليبه في التراب.",
  "tag": "[grieving, quiet]"
 },
 {
  "out": "/home/claude/r3/yas_ses/d3.wav",
  "text": "كان الرجل الوحيد الذي جعلك تشكّ في آلهتك.",
  "tag": "[grieving, quiet]"
 },
 {
  "out": "/home/claude/r3/yas_ses/d4.wav",
  "text": "وقتله رجل من آلهتك أنت.",
  "tag": "[grieving, quiet]"
 },
 {
  "out": "/home/claude/r3/yas_ses/d5.wav",
  "text": "تحلق رأسك.",
  "tag": "[grieving, quiet]"
 },
 {
  "out": "/home/claude/r3/yas_ses/d6.wav",
  "text": "وتعلّق صليبه في عنقك.",
  "tag": "[grieving, quiet]"
 }
]